---
import { Mail, Github, Linkedin, CheckCircle2, Send, Loader2, ArrowUpRight } from 'lucide-astro';
---

<section id="contacto" class="relative pt-6 pb-2 space-y-10">

  <!-- Editorial Watermark in Background -->
  <div 
    aria-hidden="true" 
    class="absolute right-0 -top-2 sm:-top-4 text-[90px] sm:text-[140px] lg:text-[170px] font-black tracking-tighter text-zinc-900/[0.08] dark:text-white/[0.08] select-none pointer-events-none -z-10 leading-none overflow-hidden"
  >
    CONTACT
  </div>

  <!-- Editorial Section Header -->
  <div class="border-b border-zinc-900/15 dark:border-white/15 pb-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="w-1.5 h-1.5 rounded-full bg-zinc-900 dark:bg-zinc-100"></span>
          <p class="text-[11px] font-mono tracking-[0.25em] uppercase text-zinc-500 dark:text-zinc-400">
            04 // CONTACTO DIRECTO · CONVERSACIÓN &amp; PROPUESTAS
          </p>
        </div>
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-zinc-950 dark:text-zinc-50 uppercase">
          ¿Hablamos sobre tu <span class="font-serif italic font-normal text-zinc-500 dark:text-zinc-400">próximo proyecto?</span>
        </h2>
      </div>
      <p class="text-xs font-mono text-zinc-500 dark:text-zinc-400 max-w-sm md:text-right leading-relaxed">
        Consultoría técnica, arquitecturas cloud escalables y desarrollo de software de alta gama.
      </p>
    </div>
  </div>

  <!-- Broadsheet Spread (Editorial layout, zero card clutter) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 border-y border-zinc-900/15 dark:border-white/15 py-8 items-start">
    
    <!-- Left Column: Direct Access Channels & Status (Email hidden from plain text) -->
    <div class="lg:col-span-5 space-y-8">
      
      <!-- Availability Status (Monochrome sober palette) -->
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-200/70 dark:bg-zinc-800/70 border border-zinc-300/80 dark:border-zinc-700/80 text-zinc-800 dark:text-zinc-200 text-xs font-mono uppercase tracking-wider font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-zinc-900 dark:bg-zinc-100 animate-pulse"></span>
          <span>Disponible para proyectos // 2026</span>
        </div>
        <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed font-sans">
          Si buscas construir una plataforma desde cero, optimizar latencias críticas o integrar un perfil Senior a tu equipo, utiliza el formulario o los accesos directos.
        </p>
      </div>

      <!-- Direct Action Icon Buttons (Email hidden behind native action) -->
      <div class="space-y-3">
        <span class="text-[10px] font-mono tracking-widest uppercase text-zinc-500 dark:text-zinc-400 block">
          CANALES DIRECTOS DE COMUNICACIÓN
        </span>

        <div class="grid grid-cols-1 gap-2.5">
          <!-- Email Direct Action -->
          <a 
            href="mailto:trujilloadrian29@gmail.com"
            aria-label="Iniciar redacción de correo"
            class="group flex items-center justify-between p-3.5 rounded-xl bg-zinc-100/60 dark:bg-zinc-900/60 border border-zinc-200/80 dark:border-zinc-800 hover:border-zinc-900 dark:hover:border-zinc-100 transition-all text-xs font-mono text-zinc-900 dark:text-zinc-100 no-underline shadow-xs"
          >
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-zinc-200/80 dark:bg-zinc-800/80 flex items-center justify-center text-zinc-700 dark:text-zinc-300 group-hover:text-zinc-950 dark:group-hover:text-white transition-colors">
                <Mail class="w-4 h-4" />
              </div>
              <div>
                <p class="font-bold uppercase tracking-wide">Correo Electrónico</p>
                <p class="text-[10px] text-zinc-500">Abrir en tu cliente de correo</p>
              </div>
            </div>
            <ArrowUpRight class="w-4 h-4 text-zinc-400 group-hover:text-zinc-950 dark:group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" />
          </a>

          <!-- GitHub Direct Action -->
          <a 
            href="https://github.com/trujilloadrian29" 
            target="_blank" 
            rel="noopener noreferrer"
            aria-label="Perfil de GitHub"
            class="group flex items-center justify-between p-3.5 rounded-xl bg-zinc-100/60 dark:bg-zinc-900/60 border border-zinc-200/80 dark:border-zinc-800 hover:border-zinc-900 dark:hover:border-zinc-100 transition-all text-xs font-mono text-zinc-900 dark:text-zinc-100 no-underline shadow-xs"
          >
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-zinc-200/80 dark:bg-zinc-800/80 flex items-center justify-center text-zinc-700 dark:text-zinc-300 group-hover:text-zinc-950 dark:group-hover:text-white transition-colors">
                <Github class="w-4 h-4" />
              </div>
              <div>
                <p class="font-bold uppercase tracking-wide">GitHub</p>
                <p class="text-[10px] text-zinc-500">Repositorios y código fuente</p>
              </div>
            </div>
            <ArrowUpRight class="w-4 h-4 text-zinc-400 group-hover:text-zinc-950 dark:group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" />
          </a>

          <!-- LinkedIn Direct Action -->
          <a 
            href="https://linkedin.com" 
            target="_blank" 
            rel="noopener noreferrer"
            aria-label="Perfil de LinkedIn"
            class="group flex items-center justify-between p-3.5 rounded-xl bg-zinc-100/60 dark:bg-zinc-900/60 border border-zinc-200/80 dark:border-zinc-800 hover:border-zinc-900 dark:hover:border-zinc-100 transition-all text-xs font-mono text-zinc-900 dark:text-zinc-100 no-underline shadow-xs"
          >
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-zinc-200/80 dark:bg-zinc-800/80 flex items-center justify-center text-zinc-700 dark:text-zinc-300 group-hover:text-zinc-950 dark:group-hover:text-white transition-colors">
                <Linkedin class="w-4 h-4" />
              </div>
              <div>
                <p class="font-bold uppercase tracking-wide">LinkedIn</p>
                <p class="text-[10px] text-zinc-500">Conexión profesional</p>
              </div>
            </div>
            <ArrowUpRight class="w-4 h-4 text-zinc-400 group-hover:text-zinc-950 dark:group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" />
          </a>
        </div>
      </div>

      <!-- Editorial Metadata note -->
      <div class="pt-2 flex items-center gap-2 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span class="w-1.5 h-1.5 rounded-full bg-zinc-400"></span>
        <span>Zona horaria: UTC-5 / Remoto internacional</span>
      </div>

    </div>

    <!-- Right Column: Interactive Dispatch Form & Thank You View -->
    <div class="lg:col-span-7">
      
      <!-- Thank You / Dispatch Received View (Initially Hidden) -->
      <div 
        id="contact-form-success" 
        class="hidden py-8 px-6 sm:px-8 rounded-2xl bg-zinc-100/80 dark:bg-zinc-900/80 border border-zinc-300 dark:border-zinc-700 text-left space-y-6 transition-all duration-500"
      >
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-zinc-200 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-50 flex items-center justify-center">
            <CheckCircle2 class="w-5 h-5" />
          </div>
          <div>
            <span class="text-[10px] font-mono tracking-widest uppercase text-zinc-500 dark:text-zinc-400 font-bold block">
              MENSAJE ENVIADO // CONFIRMACIÓN
            </span>
            <h3 class="text-xl font-bold uppercase tracking-tight text-zinc-950 dark:text-zinc-50">
              ¡Muchas gracias por comunicarte!
            </h3>
          </div>
        </div>

        <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed font-sans">
          He recibido tu mensaje correctamente. Analizaré con detenimiento los detalles de tu consulta o propuesta y te responderé en un plazo menor a 24 horas.
        </p>

        <!-- Editorial Dispatch Receipt Box (No email exposed) -->
        <div class="p-4 rounded-xl bg-white dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 space-y-2 font-mono text-[11px]">
          <div class="flex items-center justify-between text-zinc-500 dark:text-zinc-400 pb-1.5 border-b border-zinc-200 dark:border-zinc-800">
            <span>DESTINATARIO:</span>
            <span class="font-bold text-zinc-900 dark:text-zinc-100">Dennis Trujillo</span>
          </div>
          <div class="flex items-center justify-between text-zinc-500 dark:text-zinc-400 pb-1.5 border-b border-zinc-200 dark:border-zinc-800">
            <span>CANAL:</span>
            <span class="text-zinc-900 dark:text-zinc-100">Formulario Web Seguro</span>
          </div>
          <div class="flex items-center justify-between text-zinc-500 dark:text-zinc-400">
            <span>ESTADO:</span>
            <span class="text-zinc-900 dark:text-zinc-100 font-semibold flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-zinc-900 dark:bg-zinc-100 animate-pulse"></span>
              EN COLA DE REVISIÓN PRIORITARIA
            </span>
          </div>
        </div>

        <button 
          id="contact-reset-btn"
          type="button"
          class="px-5 py-2.5 rounded-xl border border-zinc-300 dark:border-zinc-700 hover:bg-zinc-200 dark:hover:bg-zinc-800 text-xs font-mono font-medium text-zinc-900 dark:text-zinc-100 transition-colors cursor-pointer"
        >
          ← Enviar otro mensaje
        </button>
      </div>

      <!-- The Form -->
      <form id="portfolio-contact-form" class="space-y-5">
        <div>
          <label for="contact-name" class="block text-[11px] font-mono tracking-wider uppercase text-zinc-500 dark:text-zinc-400 mb-1.5">
            01 // TU NOMBRE O EMPRESA
          </label>
          <input 
            id="contact-name"
            type="text" 
            required
            placeholder="Ej. Carlos Mendoza · Tech Lead" 
            class="w-full px-4 py-3 rounded-xl bg-zinc-100/70 dark:bg-zinc-900/80 border border-zinc-200 dark:border-zinc-800 text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-zinc-600 text-sm focus:outline-none focus:ring-1 focus:ring-zinc-950 dark:focus:ring-zinc-100 transition-all font-mono"
          />
        </div>

        <div>
          <label for="contact-email" class="block text-[11px] font-mono tracking-wider uppercase text-zinc-500 dark:text-zinc-400 mb-1.5">
            02 // TU CORREO ELECTRÓNICO
          </label>
          <input 
            id="contact-email"
            type="email" 
            required
            placeholder="carlos@empresa.com" 
            class="w-full px-4 py-3 rounded-xl bg-zinc-100/70 dark:bg-zinc-900/80 border border-zinc-200 dark:border-zinc-800 text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-zinc-600 text-sm focus:outline-none focus:ring-1 focus:ring-zinc-950 dark:focus:ring-zinc-100 transition-all font-mono"
          />
        </div>

        <div>
          <label for="contact-message" class="block text-[11px] font-mono tracking-wider uppercase text-zinc-500 dark:text-zinc-400 mb-1.5">
            03 // MENSAJE O DETALLES DEL PROYECTO
          </label>
          <textarea 
            id="contact-message"
            rows="4"
            required
            placeholder="Hola Dennis, me gustaría consultar tu disponibilidad para liderar la arquitectura de un sistema distribuido..."
            class="w-full px-4 py-3 rounded-xl bg-zinc-100/70 dark:bg-zinc-900/80 border border-zinc-200 dark:border-zinc-800 text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-zinc-600 text-sm focus:outline-none focus:ring-1 focus:ring-zinc-950 dark:focus:ring-zinc-100 transition-all resize-none font-sans"
          ></textarea>
        </div>

        <!-- Submit Button with Dynamic Animated States -->
        <button 
          id="contact-submit-btn"
          type="submit"
          class="group relative w-full py-4 px-6 text-xs font-mono font-bold uppercase tracking-wider text-white dark:text-zinc-950 bg-zinc-950 dark:bg-zinc-100 hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-all rounded-xl flex items-center justify-center gap-2.5 shadow-md hover:shadow-lg cursor-pointer overflow-hidden disabled:opacity-75 disabled:cursor-wait"
        >
          <!-- Default State Content -->
          <span id="btn-default-content" class="flex items-center gap-2.5 transition-all duration-300">
            <span>Enviar Mensaje</span>
            <Send class="w-4 h-4 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" />
          </span>

          <!-- Sending / Animation State Content (Initially Hidden) -->
          <span id="btn-sending-content" class="hidden items-center gap-2.5 transition-all duration-300">
            <Loader2 class="w-4 h-4 animate-spin text-zinc-400 dark:text-zinc-600" />
            <span class="animate-pulse">Enviando mensaje...</span>
          </span>
        </button>
      </form>

    </div>

  </div>

  <!-- Editorial Footnote -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2 text-[11px] font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-zinc-400"></span>
      <span>PRIVACIDAD: DATOS TRATADOS DE FORMA CONFIDENCIAL Y SEGURA</span>
    </div>
    <div>
      <span>DISPONIBILIDAD INMEDIATA // RESPUESTA EN &lt; 24H</span>
    </div>
  </div>

</section>

<script>
  function setupContact() {
    const form = document.getElementById('portfolio-contact-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
    const btnDefault = document.getElementById('btn-default-content');
    const btnSending = document.getElementById('btn-sending-content');
    const successBox = document.getElementById('contact-form-success');
    const resetBtn = document.getElementById('contact-reset-btn');

    if (form && submitBtn && btnDefault && btnSending && successBox && !form.hasAttribute('data-form-bound')) {
      form.setAttribute('data-form-bound', 'true');
      
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        // 1. Trigger sending animation
        submitBtn.disabled = true;
        btnDefault.classList.add('hidden');
        btnSending.classList.remove('hidden');
        btnSending.classList.add('flex');

        // 2. Realistic dispatch delay (1.2 seconds)
        setTimeout(() => {
          // Hide form, show thank you receipt
          form.classList.add('hidden');
          successBox.classList.remove('hidden');

          // Reset button state
          submitBtn.disabled = false;
          btnSending.classList.add('hidden');
          btnSending.classList.remove('flex');
          btnDefault.classList.remove('hidden');
          form.reset();
        }, 1200);
      });
    }

    if (resetBtn && form && successBox && !resetBtn.hasAttribute('data-reset-bound')) {
      resetBtn.setAttribute('data-reset-bound', 'true');
      resetBtn.addEventListener('click', () => {
        successBox.classList.add('hidden');
        form.classList.remove('hidden');
      });
    }
  }

  document.addEventListener('astro:page-load', setupContact);
</script>
