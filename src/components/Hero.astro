---
import { 
  Github, 
  Linkedin, 
  FileDown, 
  ArrowUpRight 
} from 'lucide-astro';
---

<section id="hero-section" class="relative w-full pt-0 pb-10 select-none">

  <!-- Lateral Watermarks: Revista Editorial Style -->
  <!-- Left Lateral Watermark -->
  <aside 
    id="hero-watermark-left"
    aria-hidden="true"
    class="absolute -left-4 sm:-left-6 lg:-left-6 xl:-left-10 top-1/2 -translate-y-1/2 hidden lg:flex flex-col items-center gap-6 text-[10px] font-mono tracking-[0.25em] uppercase pointer-events-none select-none z-10 will-change-transform will-change-opacity"
  >
    <span class="w-px h-16 bg-gradient-to-b from-transparent via-zinc-300 dark:via-zinc-700 to-transparent"></span>
    <span class="[writing-mode:vertical-lr] rotate-180 flex items-center gap-3 whitespace-nowrap text-zinc-500 dark:text-zinc-400 font-medium">
      <span class="w-1.5 h-1.5 rounded-full bg-amber-500/70"></span>
      FULL STACK SOFTWARE ENGINEER · PORTFOLIO 2026
    </span>
    <span class="w-px h-16 bg-gradient-to-b from-transparent via-zinc-300 dark:via-zinc-700 to-transparent"></span>
  </aside>

  <!-- Right Lateral Watermark -->
  <aside 
    id="hero-watermark-right"
    aria-hidden="true"
    class="absolute -right-4 sm:-right-6 lg:-right-6 xl:-right-10 top-1/2 -translate-y-1/2 hidden lg:flex flex-col items-center gap-6 text-[11px] font-mono tracking-[0.25em] uppercase pointer-events-none select-none z-10 will-change-transform will-change-opacity"
  >
    <span class="w-px h-16 bg-gradient-to-b from-transparent via-zinc-400 dark:via-zinc-600 to-transparent"></span>
    <span class="[writing-mode:vertical-rl] flex items-center gap-3 whitespace-nowrap text-emerald-600 dark:text-emerald-400 font-semibold">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
      DISPONIBLE PARA PROYECTOS · EXCLUSIVO
    </span>
    <span class="w-px h-16 bg-gradient-to-b from-transparent via-zinc-400 dark:via-zinc-600 to-transparent"></span>
  </aside>

  <!-- Mobile Minimal Status (visible solo en móviles y tablets) -->
  <div id="hero-mobile-status" class="lg:hidden flex items-center justify-between pb-2 text-[10px] font-mono uppercase tracking-widest text-zinc-500 dark:text-zinc-400 will-change-transform will-change-opacity">
    <span class="font-semibold text-zinc-800 dark:text-zinc-200">FULL STACK DEVELOPER // 2026</span>
    <span class="text-emerald-600 dark:text-emerald-400 font-semibold flex items-center gap-1.5">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
      DISPONIBLE
    </span>
  </div>

  <!-- 1. GRAND MAGAZINE COVER MASTHEAD -->
  <div id="hero-masthead" class="pt-1 sm:pt-3 pb-5 text-center border-b border-zinc-900/15 dark:border-white/15 overflow-hidden will-change-transform will-change-opacity">
    <h1 class="text-5xl sm:text-7xl md:text-9xl lg:text-[10.5rem] font-black tracking-tighter text-zinc-950 dark:text-zinc-50 uppercase leading-[0.82] select-text">
      DENNIS TRUJILLO
    </h1>
  </div>

  <!-- 3. VISUAL COVER SPREAD: AVATAR AS PURE CUTOUT CENTERPIECE -->
  <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-6 py-6 lg:py-8 items-center border-b border-zinc-900/15 dark:border-white/15">
    
    <!-- Left Column: Key Highlights -->
    <div id="hero-left-column" class="lg:col-span-3 space-y-6 order-2 lg:order-1 will-change-transform will-change-opacity">
      <div class="space-y-1.5">
        <span class="text-[10px] font-mono tracking-widest uppercase text-amber-600 dark:text-amber-500 font-bold block">
          ARQUITECTURA // 01
        </span>
        <p class="text-xl sm:text-2xl font-black uppercase tracking-tight text-zinc-950 dark:text-zinc-100 leading-tight">
          SISTEMAS DISTRIBUIDOS
        </p>
        <p class="text-xs font-mono text-zinc-500 dark:text-zinc-400 pt-0.5">
          500K+ Req/día · &lt;15ms de latencia
        </p>
      </div>

      <div class="pt-4 border-t border-zinc-300 dark:border-zinc-800/80 space-y-1.5">
        <span class="text-[10px] font-mono tracking-widest uppercase text-zinc-500 dark:text-zinc-400 block">
          INFRAESTRUCTURA // 02
        </span>
        <p class="text-lg font-bold uppercase tracking-tight text-zinc-950 dark:text-zinc-100">
          ASTRO + CLOUD K8S
        </p>
        <p class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
          Arquitectura sin interrupciones
        </p>
      </div>

      <div class="pt-4 border-t border-zinc-300 dark:border-zinc-800/80 space-y-1">
        <span class="text-[10px] font-mono tracking-widest uppercase text-zinc-500 dark:text-zinc-400 block">
          ENFOQUE TÉCNICO // 03
        </span>
        <p class="text-sm font-semibold text-zinc-800 dark:text-zinc-200">
          De monolitos a microservicios resilientes en producción.
        </p>
      </div>
    </div>

    <!-- Center Column: Cutout Avatar with Monumental Stature & Parallax Zoom -->
    <div 
      class="lg:col-span-6 flex flex-col items-center justify-center order-1 lg:order-2 group relative"
    >
      <!-- Atmospheric dual halo: diffuse ambient glow + subtle compass orbit ring -->
      <div id="hero-halo" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-72 h-72 sm:w-96 sm:h-96 lg:w-[480px] lg:h-[480px] bg-gradient-to-tr from-zinc-300/30 via-zinc-200/20 to-zinc-400/10 dark:from-zinc-800/30 dark:via-zinc-700/20 dark:to-zinc-600/10 rounded-full blur-3xl pointer-events-none -z-10 will-change-transform will-change-opacity"></div>
      <div id="hero-ring" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 sm:w-80 sm:h-80 lg:w-[420px] lg:h-[420px] rounded-full border border-zinc-900/[0.06] dark:border-white/[0.06] pointer-events-none -z-10 will-change-transform will-change-opacity"></div>

      <!-- Pure Avatar Silhouette Cutout (Epic Stature with Masthead Overlap & Zoom Parallax) -->
      <div 
        id="hero-avatar-container"
        class="relative w-full max-w-[360px] sm:max-w-[440px] md:max-w-[480px] lg:max-w-[540px] xl:max-w-[580px] flex flex-col items-center justify-center -mt-2 sm:-mt-6 lg:-mt-12 xl:-mt-16 z-10 will-change-transform"
      >
        
        <!-- Archival Corner Crop Marks (Subtle Swiss Editorial framing) -->
        <span class="absolute top-6 left-2 sm:left-4 w-4 h-4 border-t border-l border-zinc-400/40 dark:border-zinc-600/40 pointer-events-none hidden sm:block"></span>
        <span class="absolute top-6 right-2 sm:right-4 w-4 h-4 border-t border-r border-zinc-400/40 dark:border-zinc-600/40 pointer-events-none hidden sm:block"></span>
        <span class="absolute bottom-10 left-2 sm:left-4 w-4 h-4 border-b border-l border-zinc-400/40 dark:border-zinc-600/40 pointer-events-none hidden sm:block"></span>
        <span class="absolute bottom-10 right-2 sm:right-4 w-4 h-4 border-b border-r border-zinc-400/40 dark:border-zinc-600/40 pointer-events-none hidden sm:block"></span>

        <img 
          id="hero-avatar-img"
          src="/profile.png"
          alt="Dennis Trujillo - Full Stack Software Engineer"
          class="w-full max-h-[500px] sm:max-h-[580px] lg:max-h-[660px] xl:max-h-[720px] object-contain transition-transform duration-300 ease-out filter drop-shadow-[0_24px_38px_rgba(0,0,0,0.22)] dark:drop-shadow-[0_25px_45px_rgba(255,255,255,0.09)] bg-transparent [mask-image:linear-gradient(to_bottom,black_85%,transparent_100%)] [-webkit-mask-image:linear-gradient(to_bottom,black_85%,transparent_100%)] origin-bottom will-change-transform"
          style="-webkit-mask-image: linear-gradient(to bottom, black 85%, transparent 100%); mask-image: linear-gradient(to bottom, black 85%, transparent 100%);"
        />

        <!-- Floating Technical Spec Badge -->
        <div id="hero-badge" class="absolute bottom-6 sm:bottom-8 right-2 sm:right-4 z-20 px-3.5 py-1.5 rounded-full bg-white/95 dark:bg-zinc-900/95 backdrop-blur-md border border-zinc-200 dark:border-zinc-800 text-[10px] font-mono uppercase tracking-widest text-zinc-900 dark:text-zinc-100 shadow-md flex items-center gap-2 will-change-transform will-change-opacity">
          <span class="w-1.5 h-1.5 rounded-full bg-zinc-900 dark:bg-zinc-100 animate-pulse"></span>
          <span>INGENIERO FULL STACK</span>
        </div>

      </div>
    </div>

    <!-- Right Column: Engineering Philosophy & Stack -->
    <div id="hero-right-column" class="lg:col-span-3 space-y-6 order-3 will-change-transform will-change-opacity">
      <div class="space-y-3">
        <span class="text-[10px] font-mono tracking-widest uppercase text-zinc-500 dark:text-zinc-400 block">
          FILOSOFÍA DE DESARROLLO
        </span>
        <p class="text-xl sm:text-2xl font-serif italic text-zinc-900 dark:text-zinc-100 leading-snug">
          &ldquo;Software de precisión donde la ingeniería de alto rendimiento y el diseño minimalista convergen.&rdquo;
        </p>
      </div>

      <div class="pt-4 border-t border-zinc-300 dark:border-zinc-800/80 space-y-2">
        <span class="text-[10px] font-mono tracking-widest uppercase text-zinc-500 dark:text-zinc-400 block">
          STACK PRINCIPAL
        </span>
        <p class="text-xs font-mono font-bold text-zinc-950 dark:text-zinc-100 uppercase tracking-wide">
          TypeScript · Astro · React 19 · Node.js · PostgreSQL · Docker
        </p>
      </div>

      <div class="pt-4 border-t border-zinc-300 dark:border-zinc-800/80 space-y-1">
        <span class="text-[10px] font-mono tracking-widest uppercase text-zinc-500 dark:text-zinc-400 block">
          UBICACIÓN // DISPONIBILIDAD
        </span>
        <p class="text-xs font-mono text-zinc-700 dark:text-zinc-300">
          Remoto / Internacional (Zona horaria flexible)
        </p>
      </div>
    </div>

  </div>

  <!-- 4. MAGAZINE FOOTER STRIP: CTAS, METRICS & BARCODE (Exento de parallax para preservar interactividad de botones y métricas) -->
  <div id="hero-footer-strip" class="pt-6 flex flex-col md:flex-row items-center justify-between gap-6 relative z-30">
    
    <!-- Primary Interactive CTAs -->
    <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
      <a 
        href="#proyectos"
        class="px-8 py-3.5 text-xs font-bold uppercase tracking-wider text-white dark:text-zinc-950 bg-zinc-950 dark:bg-zinc-100 rounded-xl hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-all shadow-md hover:shadow-lg flex items-center gap-2.5 group cursor-pointer no-underline"
      >
        <span>Ver Proyectos</span>
        <ArrowUpRight class="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
      </a>

      <!-- Botón de Descargar CV -->
      <a 
        id="hero-cv-btn"
        href="/cv-dennis-trujillo.pdf"
        download="Dennis_Trujillo_CV.pdf"
        class="px-6 py-3.5 text-xs font-mono font-medium text-zinc-900 dark:text-zinc-100 bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-all rounded-xl border border-zinc-300 dark:border-zinc-700 flex items-center gap-2 cursor-pointer shadow-xs group no-underline"
      >
        <FileDown class="w-4 h-4 text-zinc-600 dark:text-zinc-400 group-hover:translate-y-0.5 transition-transform" />
        <span>Descargar CV</span>
      </a>

      <div class="flex items-center gap-2">
        <a 
          href="https://github.com/trujilloadrian29" 
          target="_blank" 
          rel="noopener noreferrer"
          aria-label="Perfil de GitHub"
          class="p-3.5 text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white bg-white dark:bg-zinc-900 rounded-xl hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-all border border-zinc-300 dark:border-zinc-700 shadow-xs"
        >
          <Github class="w-4 h-4" />
        </a>

        <a 
          href="https://linkedin.com" 
          target="_blank" 
          rel="noopener noreferrer"
          aria-label="Perfil de LinkedIn"
          class="p-3.5 text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white bg-white dark:bg-zinc-900 rounded-xl hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-all border border-zinc-300 dark:border-zinc-700 shadow-xs"
        >
          <Linkedin class="w-4 h-4" />
        </a>
      </div>
    </div>

    <!-- Authentic Magazine Barcode & Metrics -->
    <div class="flex items-center gap-6 self-end md:self-auto">
      <div class="hidden sm:grid grid-cols-3 gap-6 text-right font-mono">
        <div>
          <p class="text-xl font-black text-zinc-950 dark:text-zinc-100 tabular-nums">+4</p>
          <p class="text-[9px] uppercase text-zinc-500">Años</p>
        </div>
        <div>
          <p class="text-xl font-black text-zinc-950 dark:text-zinc-100 tabular-nums">20+</p>
          <p class="text-[9px] uppercase text-zinc-500">Sistemas</p>
        </div>
        <div>
          <p class="text-xl font-black text-zinc-950 dark:text-zinc-100 tabular-nums">99.9%</p>
          <p class="text-[9px] uppercase text-zinc-500">Uptime</p>
        </div>
      </div>

      <!-- Barcode Graphic -->
      <div class="p-2 bg-white dark:bg-zinc-900 rounded border border-zinc-300/80 dark:border-zinc-800 shadow-xs flex flex-col items-center">
        <svg class="h-6 w-24 text-zinc-900 dark:text-zinc-100" viewBox="0 0 112 28" fill="currentColor">
          <rect x="0" y="0" width="2" height="24" />
          <rect x="4" y="0" width="1" height="24" />
          <rect x="7" y="0" width="3" height="24" />
          <rect x="12" y="0" width="1" height="24" />
          <rect x="15" y="0" width="2" height="24" />
          <rect x="19" y="0" width="4" height="24" />
          <rect x="25" y="0" width="1" height="24" />
          <rect x="28" y="0" width="2" height="24" />
          <rect x="32" y="0" width="1" height="24" />
          <rect x="35" y="0" width="3" height="24" />
          <rect x="40" y="0" width="2" height="24" />
          <rect x="44" y="0" width="1" height="24" />
          <rect x="47" y="0" width="4" height="24" />
          <rect x="53" y="0" width="2" height="24" />
          <rect x="57" y="0" width="1" height="24" />
          <rect x="60" y="0" width="3" height="24" />
          <rect x="65" y="0" width="1" height="24" />
          <rect x="68" y="0" width="2" height="24" />
          <rect x="72" y="0" width="4" height="24" />
          <rect x="78" y="0" width="1" height="24" />
          <rect x="81" y="0" width="3" height="24" />
          <rect x="86" y="0" width="2" height="24" />
          <rect x="90" y="0" width="1" height="24" />
          <rect x="93" y="0" width="3" height="24" />
          <rect x="98" y="0" width="2" height="24" />
          <rect x="102" y="0" width="4" height="24" />
          <rect x="108" y="0" width="2" height="24" />
        </svg>
        <span class="text-[7px] font-mono tracking-widest text-zinc-500 mt-0.5">
          0 74470 99420 8
        </span>
      </div>
    </div>

  </div>

</section>

<script>
  let removeParallaxListener: (() => void) | null = null;

  function setupHero() {
    try {
      localStorage.removeItem('alex_portfolio_avatar');
    } catch {
      // Ignore if localStorage is disabled or restricted
    }

    // --- Parallax Scroll Effect: Zoom Avatar & Fade Out Text ---
    if (removeParallaxListener) {
      removeParallaxListener();
      removeParallaxListener = null;
    }

    const heroSection = document.getElementById('hero-section');
    const masthead = document.getElementById('hero-masthead');
    const leftCol = document.getElementById('hero-left-column');
    const rightCol = document.getElementById('hero-right-column');
    const mobileStatus = document.getElementById('hero-mobile-status');
    const watermarkLeft = document.getElementById('hero-watermark-left');
    const watermarkRight = document.getElementById('hero-watermark-right');
    const avatarImg = document.getElementById('hero-avatar-img');
    const avatarHalo = document.getElementById('hero-halo');
    const avatarRing = document.getElementById('hero-ring');
    const badge = document.getElementById('hero-badge');

    if (!heroSection || !avatarImg) return;

    let ticking = false;

    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const scrollY = window.scrollY || window.pageYOffset;
          const heroHeight = heroSection.offsetHeight || 600;

          // Rango de distancia para el efecto completo (hasta 560px de scroll)
          const maxDistance = Math.min(heroHeight * 0.9, 560);
          const progress = Math.min(Math.max(scrollY / maxDistance, 0), 1);

          // 1. IMAGEN DE PERFIL (Fase 1 - Actúa desde el inicio del scroll)
          // La imagen crece inmediatamente desde el primer pixel de scroll
          const avatarScale = (1 + progress * 0.32).toFixed(3);
          const avatarTranslateY = (progress * 18).toFixed(2);
          avatarImg.style.transform = `scale(${avatarScale}) translate3d(0, ${avatarTranslateY}px, 0)`;

          // El resplandor (halo) y anillo reaccionan desde el inicio
          if (avatarHalo) {
            const haloScale = (1 + progress * 0.45).toFixed(3);
            const haloOpacity = (0.3 + progress * 0.4).toFixed(3);
            avatarHalo.style.transform = `translate(-50%, -50%) scale(${haloScale})`;
            avatarHalo.style.opacity = haloOpacity;
          }
          if (avatarRing) {
            const ringScale = (1 + progress * 0.35).toFixed(3);
            avatarRing.style.transform = `translate(-50%, -50%) scale(${ringScale})`;
          }

          // 2. TEXTOS (Solo en Desktop >= 1024px: en móviles y tablets el texto se coloca en columna y debe permanecer 100% visible)
          const isDesktop = window.innerWidth >= 1024;

          if (isDesktop) {
            const textFadeStart = 0.45;
            let textOpacity = 1;
            let textShift = 0;

            if (progress > textFadeStart) {
              const textFadeProgress = (progress - textFadeStart) / (1 - textFadeStart);
              textOpacity = Math.max(0, 1 - textFadeProgress * 1.1);
              textShift = textFadeProgress * 26;
            }

            const textStyleTransform = `translate3d(0, ${-textShift}px, 0)`;
            const textStyleOpacity = textOpacity.toFixed(3);

            if (masthead) {
              masthead.style.opacity = textStyleOpacity;
              masthead.style.transform = textStyleTransform;
            }
            if (leftCol) {
              leftCol.style.opacity = textStyleOpacity;
              leftCol.style.transform = `translate3d(${-textShift * 0.6}px, ${-textShift}px, 0)`;
            }
            if (rightCol) {
              rightCol.style.opacity = textStyleOpacity;
              rightCol.style.transform = `translate3d(${textShift * 0.6}px, ${-textShift}px, 0)`;
            }
            if (watermarkLeft) {
              watermarkLeft.style.opacity = textStyleOpacity;
            }
            if (watermarkRight) {
              watermarkRight.style.opacity = textStyleOpacity;
            }
          } else {
            // En móviles y tablets: restablecer estilos para legibilidad perfecta y fija
            if (masthead && masthead.style.opacity !== '') {
              masthead.style.opacity = '';
              masthead.style.transform = '';
            }
            if (leftCol && leftCol.style.opacity !== '') {
              leftCol.style.opacity = '';
              leftCol.style.transform = '';
            }
            if (rightCol && rightCol.style.opacity !== '') {
              rightCol.style.opacity = '';
              rightCol.style.transform = '';
            }
            if (watermarkLeft && watermarkLeft.style.opacity !== '') {
              watermarkLeft.style.opacity = '';
            }
            if (watermarkRight && watermarkRight.style.opacity !== '') {
              watermarkRight.style.opacity = '';
            }
            if (mobileStatus && mobileStatus.style.opacity !== '') {
              mobileStatus.style.opacity = '';
            }
          }

          if (badge) {
            // El badge técnico del avatar se desvanece de forma suave y sincronizada
            const badgeOpacity = progress > 0.4 ? Math.max(0, 1 - ((progress - 0.4) / 0.5)).toFixed(3) : '1';
            badge.style.opacity = badgeOpacity;
          }

          ticking = false;
        });
        ticking = true;
      }
    };

    const onResize = () => {
      onScroll();
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize, { passive: true });
    // Inicializar estado inmediato
    onScroll();

    removeParallaxListener = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onResize);
    };
  }

  // Soporte para Astro View Transitions y carga inicial
  document.addEventListener('astro:page-load', setupHero);
  document.addEventListener('astro:before-swap', () => {
    if (removeParallaxListener) {
      removeParallaxListener();
      removeParallaxListener = null;
    }
  });
</script>
