---
import type { SkillGroup } from '../types/portfolio';
import { Code2, Server, Database, Cpu } from 'lucide-astro';

interface Props {
  skills: SkillGroup[];
}

const { skills } = Astro.props;

const iconMap = {
  Code2,
  Server,
  Database,
  Cpu
};

const categoryMeta: Record<string, { label: string; desc: string; index: string }> = {
  'Frontend & UI': {
    label: 'Capa Visual & Cliente',
    desc: 'Arquitectura de interfaces reactivas, rendimiento web y accesibilidad.',
    index: '01'
  },
  'Backend & APIs': {
    label: 'Servicios & Lógica',
    desc: 'Sistemas distribuidos, microservicios y protocolos de baja latencia.',
    index: '02'
  },
  'Bases de datos': {
    label: 'Persistencia & Caché',
    desc: 'Diseño relacional, consultas optimizadas y capas en memoria.',
    index: '03'
  },
  'Cloud & DevOps': {
    label: 'Infraestructura & CI/CD',
    desc: 'Contenerización, orquestación cloud y despliegues automatizados.',
    index: '04'
  }
};
---

<section id="habilidades" class="relative pt-6 pb-2 space-y-10">

  <!-- Editorial Watermark in Background -->
  <div 
    aria-hidden="true" 
    class="absolute right-0 -top-2 sm:-top-4 text-[90px] sm:text-[140px] lg:text-[170px] font-black tracking-tighter text-zinc-900/[0.08] dark:text-white/[0.08] select-none pointer-events-none -z-10 leading-none overflow-hidden"
  >
    STACK
  </div>

  <!-- Editorial Section Header -->
  <div class="border-b border-zinc-900/15 dark:border-white/15 pb-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
          <p class="text-[11px] font-mono tracking-[0.25em] uppercase text-zinc-500 dark:text-zinc-400">
            02 // COMPETENCIAS TÉCNICAS · STACK DE DESARROLLO
          </p>
        </div>
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-zinc-950 dark:text-zinc-50 uppercase">
          Stack Tecnológico <span class="font-serif italic font-normal text-zinc-500 dark:text-zinc-400">&amp;</span> Habilidades
        </h2>
      </div>
      <p class="text-xs font-mono text-zinc-500 dark:text-zinc-400 max-w-sm md:text-right leading-relaxed">
        Herramientas, tecnologías y estándares aplicados en arquitectura y producción de software.
      </p>
    </div>
  </div>

  <!-- Editorial Ledger / Broadsheet Columns (No generic cards, pure architectural typography) -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-0 lg:divide-x divide-zinc-900/15 dark:divide-white/15 border-y border-zinc-900/15 dark:border-white/15 py-8">
    {skills.map((group, idx) => {
      const IconComponent = iconMap[group.iconName] || Code2;
      const meta = categoryMeta[group.category] || {
        label: group.category,
        desc: 'Dominio técnico y buenas prácticas.',
        index: String(idx + 1).padStart(2, '0')
      };

      return (
        <div class="flex flex-col justify-between space-y-6 lg:px-6 first:lg:pl-0 last:lg:pr-0">
          
          <!-- Column Head -->
          <div class="space-y-3">
            <div class="flex items-center justify-between text-zinc-400 dark:text-zinc-500">
              <span class="text-[10px] font-mono tracking-widest uppercase">
                ÁREA {meta.index} //
              </span>
              <IconComponent class="w-4 h-4 text-zinc-600 dark:text-zinc-400" />
            </div>

            <div>
              <h3 class="text-lg font-bold tracking-tight text-zinc-950 dark:text-zinc-50 uppercase">
                {group.category}
              </h3>
              <p class="text-[11px] font-mono text-amber-600 dark:text-amber-500 uppercase tracking-wide mt-0.5">
                {meta.label}
              </p>
            </div>

            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed font-sans">
              {meta.desc}
            </p>
          </div>

          <!-- Editorial Skills Ledger -->
          <div class="pt-4 border-t border-zinc-900/10 dark:border-white/10 space-y-1">
            {group.skills.map((skill, sIdx) => (
              <div class="group/item flex items-center justify-between py-2 border-b border-zinc-200/70 dark:border-zinc-800/70 hover:border-zinc-900/40 dark:hover:border-white/30 transition-colors">
                <span class="text-xs font-mono font-medium text-zinc-800 dark:text-zinc-200 group-hover/item:text-zinc-950 dark:group-hover/item:text-white group-hover/item:translate-x-1 transition-transform inline-block">
                  {skill}
                </span>
                <span class="text-[10px] font-mono text-zinc-400 dark:text-zinc-600 group-hover/item:text-amber-600 dark:group-hover/item:text-amber-500 transition-colors">
                  {String(sIdx + 1).padStart(2, '0')}
                </span>
              </div>
            ))}
          </div>

        </div>
      );
    })}
  </div>

  <!-- Editorial Footnote / Architectural Guarantee -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2 text-[11px] font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>ESTÁNDAR: CLEAN CODE · TYPE-SAFE · CLOUD NATIVE</span>
    </div>
    <div class="flex items-center gap-4">
      <span>FILOSOFÍA // RENDIMIENTO PRIMERO</span>
      <span>·</span>
      <span>SIN DEPENDENCIAS REDUNDANTES</span>
    </div>
  </div>

</section>
