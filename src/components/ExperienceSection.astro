---
import type { ExperienceItem } from '../types/portfolio';
import { Terminal, GitBranch, Code2, Cpu, ChevronLeft, ChevronRight } from 'lucide-astro';

interface Props {
  experience: ExperienceItem[];
  pageSize?: number;
}

const { experience, pageSize = 2 } = Astro.props;

const milestoneIcons = [
  Terminal,  // Senior Full Stack / Architecture
  GitBranch, // Full Stack / High Concurrency & APIs
  Code2,     // Frontend & UI Engineering
  Cpu        // Core Foundations / Junior Systems
];

const milestoneMeta = [
  { tag: 'ROL ACTUAL // SISTEMAS EN PRODUCCIÓN', context: 'Liderazgo técnico, arquitecturas cloud y microservicios escalables.' },
  { tag: 'ETAPA PREVIA // CONCURRENCIA & APIS', context: 'Sistemas fintech, logística de alta escala y serverless.' },
  { tag: 'CONSOLIDACIÓN // INTERFACES & RENDIMIENTO', context: 'Interfaces accesibles, sistemas de diseño y rendimiento web.' },
  { tag: 'INICIOS // DESARROLLO BASE & SISTEMAS', context: 'Desarrollo de módulos web, mantenimiento de bases de datos y arquitectura inicial.' }
];

// Chunk experience into pages
const pages: ExperienceItem[][] = [];
for (let i = 0; i < experience.length; i += pageSize) {
  pages.push(experience.slice(i, i + pageSize));
}
---

<section id="experiencia" class="relative pt-6 pb-2 space-y-10">

  <!-- Editorial Watermark in Background -->
  <div 
    aria-hidden="true" 
    class="absolute right-0 -top-2 sm:-top-4 text-[90px] sm:text-[140px] lg:text-[170px] font-black tracking-tighter text-zinc-900/[0.08] dark:text-white/[0.08] select-none pointer-events-none -z-10 leading-none overflow-hidden"
  >
    CAREER
  </div>

  <!-- Editorial Section Header -->
  <div class="border-b border-zinc-900/15 dark:border-white/15 pb-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="w-1.5 h-1.5 rounded-full bg-zinc-900 dark:bg-zinc-100"></span>
          <p class="text-[11px] font-mono tracking-[0.25em] uppercase text-zinc-500 dark:text-zinc-400">
            03 // TRAYECTORIA PROFESIONAL · HISTORIAL DE INGENIERÍA
          </p>
        </div>
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-zinc-950 dark:text-zinc-50 uppercase">
          Trayectoria <span class="font-serif italic font-normal text-zinc-500 dark:text-zinc-400">&amp;</span> Experiencia
        </h2>
      </div>
      <p class="text-xs font-mono text-zinc-500 dark:text-zinc-400 max-w-sm md:text-right leading-relaxed">
        Evolución técnica en liderazgo de ingeniería, arquitectura cloud y desarrollo de sistemas de alta concurrencia.
      </p>
    </div>
  </div>

  <!-- Alternating Timeline with Horizontal Fade Carousel -->
  <div class="relative py-6">
    
    <!-- Central Vertical Rail (Desktop) -->
    <div 
      aria-hidden="true" 
      class="absolute left-1/2 -translate-x-1/2 top-4 bottom-14 w-px bg-gradient-to-b from-transparent via-zinc-300 dark:via-zinc-700 to-transparent hidden lg:block pointer-events-none"
    ></div>

    <!-- Left Vertical Rail (Mobile / Tablet) -->
    <div 
      aria-hidden="true" 
      class="absolute left-6 -translate-x-1/2 top-4 bottom-14 w-px bg-gradient-to-b from-transparent via-zinc-300 dark:via-zinc-700 to-transparent lg:hidden pointer-events-none"
    ></div>

    <!-- Pages Container (Horizontal slide / fade) -->
    <div id="timeline-pages-container" class="relative min-h-[460px] overflow-hidden">
      {pages.map((pageItems, pageIdx) => (
        <div 
          data-timeline-page={pageIdx}
          class={`timeline-page-slide transition-all duration-300 ease-out ${
            pageIdx === 0 
              ? 'opacity-100 translate-x-0 relative pointer-events-auto block' 
              : 'opacity-0 translate-x-8 pointer-events-none absolute inset-0 hidden'
          } space-y-12 lg:space-y-16 py-2`}
        >
          {pageItems.map((exp, itemIdx) => {
            const globalIdx = pageIdx * pageSize + itemIdx;
            const isEven = globalIdx % 2 === 0;
            const IconComponent = milestoneIcons[globalIdx % milestoneIcons.length] || Terminal;
            const meta = milestoneMeta[globalIdx % milestoneMeta.length] || { tag: 'ETAPA // DESARROLLO', context: 'Ingeniería de software' };
            const isCurrent = exp.period.toLowerCase().includes('presente');
            const itemNumber = String(globalIdx + 1).padStart(2, '0');

            return (
              <div class="relative group">
                
                <!-- Central Milestone Node with Elegant SVG -->
                <div class="absolute left-6 lg:left-1/2 -translate-x-1/2 top-6 lg:top-8 z-20 flex items-center justify-center">
                  <div class="relative flex items-center justify-center">
                    {isCurrent && (
                      <span class="absolute -inset-1.5 rounded-full bg-zinc-400/20 dark:bg-zinc-600/30 animate-pulse pointer-events-none"></span>
                    )}
                    <div class={`w-11 h-11 lg:w-12 lg:h-12 rounded-full bg-[#F8F8F6] dark:bg-[#0B0B0E] border-2 ${
                      isCurrent 
                        ? 'border-zinc-950 dark:border-white text-zinc-950 dark:text-white shadow-md' 
                        : 'border-zinc-300 dark:border-zinc-700 text-zinc-600 dark:text-zinc-400'
                    } flex items-center justify-center transition-all duration-300 group-hover:scale-110 group-hover:border-zinc-950 dark:group-hover:border-white shadow-sm`}>
                      <IconComponent class="w-5 h-5" />
                    </div>
                    {isCurrent && (
                      <span class="absolute -top-1 -right-1 w-3 h-3 rounded-full bg-emerald-500 border-2 border-white dark:border-[#0B0B0E] animate-pulse"></span>
                    )}
                  </div>
                </div>

                <!-- Content Row Grid (Alternating Left / Right) -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-24 items-start pl-14 lg:pl-0">
                  
                  <!-- Column 1 (Left on Desktop) -->
                  {isEven ? (
                    /* Card on Left */
                    <div class="space-y-4 p-6 sm:p-7 rounded-2xl bg-white/70 dark:bg-zinc-900/50 border border-zinc-200/80 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-all duration-300 shadow-xs">
                      <!-- Mobile Era Tag -->
                      <div class="flex items-center justify-between text-zinc-400 dark:text-zinc-500 lg:hidden">
                        <span class="text-[10px] font-mono tracking-widest uppercase">ETAPA {itemNumber} //</span>
                        <span class="text-xs font-mono font-bold text-zinc-900 dark:text-zinc-100">{exp.period}</span>
                      </div>

                      <div>
                        <h3 class="text-xl sm:text-2xl font-black uppercase tracking-tight text-zinc-950 dark:text-zinc-50 group-hover:text-zinc-700 dark:group-hover:text-zinc-300 transition-colors">
                          {exp.role}
                        </h3>
                        <p class="text-xs font-mono font-bold text-zinc-700 dark:text-zinc-300 uppercase tracking-wide mt-1">
                          {exp.company}
                        </p>
                      </div>

                      <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed font-sans">
                        {exp.description}
                      </p>

                      <div class="pt-2 border-t border-zinc-900/10 dark:border-white/10">
                        <span class="text-[10px] font-mono tracking-widest uppercase text-zinc-400 dark:text-zinc-500 block mb-2">
                          STACK CLAVE //
                        </span>
                        <div class="flex flex-wrap items-center gap-1.5">
                          {exp.stack.map((tech) => (
                            <span class="px-2.5 py-1 rounded-lg bg-zinc-100/80 dark:bg-zinc-900/80 border border-zinc-200/80 dark:border-zinc-800 text-[11px] font-mono text-zinc-800 dark:text-zinc-200 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
                              {tech}
                            </span>
                          ))}
                        </div>
                      </div>
                    </div>
                  ) : (
                    /* Big Date & Stage Headline on Left (Desktop) */
                    <div class="hidden lg:flex flex-col justify-center items-end text-right pr-6 space-y-2 pt-6">
                      <div class="flex items-center gap-2">
                        <span class="text-[10px] font-mono tracking-widest uppercase text-zinc-400 dark:text-zinc-500">
                          ETAPA {itemNumber} //
                        </span>
                        <span class="text-[10px] font-mono tracking-widest uppercase text-zinc-500 dark:text-zinc-400 font-semibold">
                          {meta.tag}
                        </span>
                      </div>
                      <p class="text-3xl sm:text-4xl font-black font-mono tracking-tight text-zinc-950 dark:text-zinc-50">
                        {exp.period}
                      </p>
                      <p class="text-xs font-mono text-zinc-500 max-w-xs">
                        {meta.context}
                      </p>
                    </div>
                  )}

                  <!-- Column 2 (Right on Desktop) -->
                  {!isEven ? (
                    /* Card on Right */
                    <div class="space-y-4 p-6 sm:p-7 rounded-2xl bg-white/70 dark:bg-zinc-900/50 border border-zinc-200/80 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-all duration-300 shadow-xs">
                      <!-- Mobile Era Tag -->
                      <div class="flex items-center justify-between text-zinc-400 dark:text-zinc-500 lg:hidden">
                        <span class="text-[10px] font-mono tracking-widest uppercase">ETAPA {itemNumber} //</span>
                        <span class="text-xs font-mono font-bold text-zinc-900 dark:text-zinc-100">{exp.period}</span>
                      </div>

                      <div>
                        <h3 class="text-xl sm:text-2xl font-black uppercase tracking-tight text-zinc-950 dark:text-zinc-50 group-hover:text-zinc-700 dark:group-hover:text-zinc-300 transition-colors">
                          {exp.role}
                        </h3>
                        <p class="text-xs font-mono font-bold text-zinc-700 dark:text-zinc-300 uppercase tracking-wide mt-1">
                          {exp.company}
                        </p>
                      </div>

                      <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed font-sans">
                        {exp.description}
                      </p>

                      <div class="pt-2 border-t border-zinc-900/10 dark:border-white/10">
                        <span class="text-[10px] font-mono tracking-widest uppercase text-zinc-400 dark:text-zinc-500 block mb-2">
                          STACK CLAVE //
                        </span>
                        <div class="flex flex-wrap items-center gap-1.5">
                          {exp.stack.map((tech) => (
                            <span class="px-2.5 py-1 rounded-lg bg-zinc-100/80 dark:bg-zinc-900/80 border border-zinc-200/80 dark:border-zinc-800 text-[11px] font-mono text-zinc-800 dark:text-zinc-200 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
                              {tech}
                            </span>
                          ))}
                        </div>
                      </div>
                    </div>
                  ) : (
                    /* Big Date & Stage Headline on Right (Desktop) */
                    <div class="hidden lg:flex flex-col justify-center pl-6 space-y-2 pt-6">
                      <div class="flex items-center gap-2">
                        <span class="text-[10px] font-mono tracking-widest uppercase text-zinc-400 dark:text-zinc-500">
                          ETAPA {itemNumber} //
                        </span>
                        <span class="text-[10px] font-mono tracking-widest uppercase text-zinc-500 dark:text-zinc-400 font-semibold">
                          {meta.tag}
                        </span>
                      </div>
                      <p class="text-3xl sm:text-4xl font-black font-mono tracking-tight text-zinc-950 dark:text-zinc-50">
                        {exp.period}
                      </p>
                      <p class="text-xs font-mono text-zinc-500 max-w-xs">
                        {meta.context}
                      </p>
                    </div>
                  )}

                </div>

              </div>
            );
          })}
        </div>
      ))}
    </div>

    <!-- Editorial Horizontal Pagination Bar -->
    {pages.length > 1 && (
      <div class="pt-10 flex flex-col sm:flex-row items-center justify-between gap-4 relative z-20 border-t border-zinc-900/10 dark:border-white/10 mt-6">
        <div class="flex items-center gap-2 text-xs font-mono text-zinc-500 dark:text-zinc-400">
          <span class="w-1.5 h-1.5 rounded-full bg-zinc-900 dark:bg-zinc-100 animate-pulse"></span>
          <span>CRONOLOGÍA // PÁGINA <span id="timeline-current-page" class="font-bold text-zinc-900 dark:text-zinc-100">01</span> DE <span id="timeline-total-pages">{String(pages.length).padStart(2, '0')}</span></span>
        </div>

        <div class="flex items-center gap-2">
          <!-- Prev Button -->
          <button 
            id="timeline-prev-btn"
            type="button"
            disabled
            aria-label="Página anterior de trayectoria"
            class="p-2.5 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 hover:border-zinc-950 dark:hover:border-white transition-all disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer shadow-xs"
          >
            <ChevronLeft class="w-4 h-4" />
          </button>

          <!-- Page Indicator Pills -->
          <div id="timeline-page-pills" class="flex items-center gap-1.5 font-mono text-xs">
            {pages.map((_, pIdx) => (
              <button
                type="button"
                data-timeline-page-btn={pIdx}
                class={`timeline-pill-btn px-3 py-1.5 rounded-xl text-xs font-mono transition-all cursor-pointer ${
                  pIdx === 0
                    ? 'active-pill bg-zinc-950 dark:bg-zinc-100 text-white dark:text-zinc-950 font-bold shadow-xs'
                    : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800'
                }`}
              >
                {String(pIdx + 1).padStart(2, '0')}
              </button>
            ))}
          </div>

          <!-- Next Button -->
          <button 
            id="timeline-next-btn"
            type="button"
            aria-label="Página siguiente de trayectoria"
            class="p-2.5 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 hover:border-zinc-950 dark:hover:border-white transition-all disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer shadow-xs"
          >
            <ChevronRight class="w-4 h-4" />
          </button>
        </div>
      </div>
    )}

  </div>

  <!-- Editorial Footnote / Verification Guarantee -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2 text-[11px] font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 border-t border-zinc-900/15 dark:border-white/15">
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-zinc-400"></span>
      <span>HISTORIAL VERIFICADO · ENFOQUE EN IMPACTO Y ESCALABILIDAD</span>
    </div>
    <div>
      <span>+4 AÑOS EN PRODUCCIÓN // METODOLOGÍAS ÁGILES &amp; CI/CD</span>
    </div>
  </div>

</section>

<script>
  function setupTimelinePagination() {
    const prevBtn = document.getElementById('timeline-prev-btn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('timeline-next-btn') as HTMLButtonElement | null;
    const currentPageLabel = document.getElementById('timeline-current-page');
    const pillBtns = document.querySelectorAll<HTMLButtonElement>('[data-timeline-page-btn]');
    const pageSlides = document.querySelectorAll<HTMLElement>('.timeline-page-slide');

    if (!prevBtn || !nextBtn || pageSlides.length <= 1) return;
    if (prevBtn.hasAttribute('data-bound')) return;
    prevBtn.setAttribute('data-bound', 'true');

    let activeIndex = 0;
    const totalPages = pageSlides.length;
    let isAnimating = false;

    function updateUI(newIndex: number, direction: 'next' | 'prev') {
      if (newIndex === activeIndex || isAnimating) return;
      isAnimating = true;

      const currentSlide = pageSlides[activeIndex];
      const nextSlide = pageSlides[newIndex];

      // 1. Current slide fades out and drifts horizontally
      currentSlide.classList.remove('opacity-100', 'translate-x-0', 'relative', 'pointer-events-auto');
      currentSlide.classList.add(
        'opacity-0', 
        direction === 'next' ? '-translate-x-8' : 'translate-x-8', 
        'absolute', 
        'inset-0', 
        'pointer-events-none'
      );

      // 2. Prepare target slide incoming position
      nextSlide.classList.remove('hidden');
      nextSlide.classList.remove('translate-x-0', '-translate-x-8', 'translate-x-8');
      nextSlide.classList.add(
        direction === 'next' ? 'translate-x-8' : '-translate-x-8',
        'opacity-0',
        'absolute',
        'inset-0'
      );

      // 3. Trigger transition into place
      setTimeout(() => {
        currentSlide.classList.add('hidden');
        currentSlide.classList.remove('-translate-x-8', 'translate-x-8');

        nextSlide.classList.remove('absolute', 'inset-0', 'pointer-events-none');
        nextSlide.classList.add('relative', 'pointer-events-auto');

        requestAnimationFrame(() => {
          nextSlide.classList.remove('translate-x-8', '-translate-x-8', 'opacity-0');
          nextSlide.classList.add('translate-x-0', 'opacity-100');
        });

        activeIndex = newIndex;

        // Update labels & pills
        if (currentPageLabel) {
          currentPageLabel.textContent = String(activeIndex + 1).padStart(2, '0');
        }

        pillBtns.forEach((pill, idx) => {
          if (idx === activeIndex) {
            pill.className = 'timeline-pill-btn active-pill px-3 py-1.5 rounded-xl text-xs font-mono font-bold transition-all cursor-pointer bg-zinc-950 dark:bg-zinc-100 text-white dark:text-zinc-950 shadow-xs';
          } else {
            pill.className = 'timeline-pill-btn px-3 py-1.5 rounded-xl text-xs font-mono transition-all cursor-pointer text-zinc-500 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800';
          }
        });

        // Update button states
        prevBtn.disabled = activeIndex === 0;
        nextBtn.disabled = activeIndex === totalPages - 1;

        isAnimating = false;
      }, 260);
    }

    prevBtn.addEventListener('click', () => {
      if (activeIndex > 0) {
        updateUI(activeIndex - 1, 'prev');
      }
    });

    nextBtn.addEventListener('click', () => {
      if (activeIndex < totalPages - 1) {
        updateUI(activeIndex + 1, 'next');
      }
    });

    pillBtns.forEach((pill) => {
      pill.addEventListener('click', () => {
        const targetIdx = Number(pill.getAttribute('data-timeline-page-btn'));
        if (targetIdx !== activeIndex) {
          updateUI(targetIdx, targetIdx > activeIndex ? 'next' : 'prev');
        }
      });
    });
  }

  document.addEventListener('astro:page-load', setupTimelinePagination);
</script>
