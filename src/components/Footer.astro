---
import { ArrowUp, ArrowUpRight, Github, Linkedin, Mail } from 'lucide-astro';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-zinc-900/15 dark:border-white/15 pt-10 sm:pt-12 pb-12 mt-10 sm:mt-12">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 space-y-12">
    
    <!-- Top Colophon Masthead -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 pb-8 border-b border-zinc-900/15 dark:border-white/10">
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-zinc-900 dark:bg-zinc-100"></span>
          <p class="text-[11px] font-mono tracking-[0.25em] uppercase text-zinc-500 dark:text-zinc-400">
            PORTFOLIO // INGENIERÍA DE SOFTWARE · {currentYear}
          </p>
        </div>
        <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-zinc-950 dark:text-zinc-50 uppercase">
          Dennis Trujillo
        </h2>
        <p class="text-xs font-mono text-zinc-600 dark:text-zinc-400 max-w-md leading-relaxed">
          Senior Full Stack Software Engineer &amp; Cloud Architect. Sistemas distribuidos, rendimiento web y arquitectura resiliente.
        </p>
      </div>

      <!-- Back to Top Button -->
      <button 
        id="footer-back-to-top"
        type="button"
        aria-label="Volver al inicio de la página"
        class="group flex items-center gap-2 px-4 py-2.5 rounded-xl border border-zinc-300/80 dark:border-zinc-700/80 hover:border-zinc-900 dark:hover:border-zinc-100 text-xs font-mono uppercase tracking-wider text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white transition-all cursor-pointer w-fit shadow-xs"
      >
        <span>Volver Arriba</span>
        <ArrowUp class="w-3.5 h-3.5 group-hover:-translate-y-0.5 transition-transform" />
      </button>
    </div>

    <!-- Editorial Columns Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 pb-10 border-b border-zinc-900/15 dark:border-white/10 text-xs font-mono">
      
      <!-- Col 1: Section Index -->
      <div class="md:col-span-4 space-y-4">
        <span class="text-[10px] tracking-widest uppercase text-zinc-500 dark:text-zinc-400 block font-bold">
          01 // NAVEGACIÓN
        </span>
        <ul class="space-y-2.5">
          <li>
            <a href="#proyectos" class="text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white transition-colors flex items-center justify-between group no-underline">
              <span>Proyectos Destacados</span>
              <span class="text-zinc-400 group-hover:translate-x-0.5 transition-transform">→</span>
            </a>
          </li>
          <li>
            <a href="#habilidades" class="text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white transition-colors flex items-center justify-between group no-underline">
              <span>Stack &amp; Habilidades</span>
              <span class="text-zinc-400 group-hover:translate-x-0.5 transition-transform">→</span>
            </a>
          </li>
          <li>
            <a href="#experiencia" class="text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white transition-colors flex items-center justify-between group no-underline">
              <span>Trayectoria Profesional</span>
              <span class="text-zinc-400 group-hover:translate-x-0.5 transition-transform">→</span>
            </a>
          </li>
          <li>
            <a href="#contacto" class="text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white transition-colors flex items-center justify-between group no-underline">
              <span>Contacto Directo</span>
              <span class="text-zinc-400 group-hover:translate-x-0.5 transition-transform">→</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 2: Direct Channels -->
      <div class="md:col-span-4 space-y-4">
        <span class="text-[10px] tracking-widest uppercase text-zinc-500 dark:text-zinc-400 block font-bold">
          02 // REDES &amp; CONTACTO
        </span>
        <ul class="space-y-2.5">
          <li>
            <a 
              href="https://github.com/Dennis290699"
              target="_blank" 
              rel="noopener noreferrer"
              class="text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white transition-colors flex items-center justify-between group no-underline"
            >
              <span class="flex items-center gap-2">
                <Github class="w-3.5 h-3.5 text-zinc-500" />
                <span>GitHub</span>
              </span>
              <ArrowUpRight class="w-3.5 h-3.5 text-zinc-400 group-hover:text-zinc-950 dark:group-hover:text-white transition-colors" />
            </a>
          </li>
          <li>
            <a 
              href="https://www.linkedin.com/in/dennis-trujillo-vistin"
              target="_blank" 
              rel="noopener noreferrer"
              class="text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white transition-colors flex items-center justify-between group no-underline"
            >
              <span class="flex items-center gap-2">
                <Linkedin class="w-3.5 h-3.5 text-zinc-500" />
                <span>LinkedIn</span>
              </span>
              <ArrowUpRight class="w-3.5 h-3.5 text-zinc-400 group-hover:text-zinc-950 dark:group-hover:text-white transition-colors" />
            </a>
          </li>
          <li>
            <a 
              href="mailto:trujilloadrian29@gmail.com" 
              class="text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white transition-colors flex items-center justify-between group no-underline"
            >
              <span class="flex items-center gap-2">
                <Mail class="w-3.5 h-3.5 text-zinc-500" />
                <span>Correo Directo</span>
              </span>
              <ArrowUpRight class="w-3.5 h-3.5 text-zinc-400 group-hover:text-zinc-950 dark:group-hover:text-white transition-colors" />
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Technical Specifications & Colophon Details -->
      <div class="md:col-span-4 space-y-4">
        <span class="text-[10px] tracking-widest uppercase text-zinc-500 dark:text-zinc-400 block font-bold">
          03 // STACK DEL PORTFOLIO
        </span>
        <div class="space-y-2 text-zinc-600 dark:text-zinc-400 text-[11px] leading-relaxed">
          <div class="flex items-center justify-between py-1 border-b border-zinc-200/60 dark:border-zinc-800/60">
            <span>CORE</span>
            <span class="text-zinc-900 dark:text-zinc-100 font-bold">Astro 5 + TypeScript</span>
          </div>
          <div class="flex items-center justify-between py-1 border-b border-zinc-200/60 dark:border-zinc-800/60">
            <span>ESTILOS</span>
            <span class="text-zinc-900 dark:text-zinc-100 font-bold">Tailwind CSS v4</span>
          </div>
          <div class="flex items-center justify-between py-1 border-b border-zinc-200/60 dark:border-zinc-800/60">
            <span>TIPOGRAFÍA</span>
            <span class="text-zinc-900 dark:text-zinc-100 font-bold">Outfit &amp; Playfair</span>
          </div>
          <div class="flex items-center justify-between py-1">
            <span>ESTÁNDAR</span>
            <span class="text-zinc-900 dark:text-zinc-100 font-bold">WCAG AAA Compliance</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Legal & Publication Note -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-[10px] font-mono uppercase tracking-widest text-zinc-500 dark:text-zinc-400">
      <p>© {currentYear} DENNIS TRUJILLO · TODOS LOS DERECHOS RESERVADOS.</p>
      <p class="text-zinc-400 dark:text-zinc-600">DISEÑADO &amp; DESARROLLADO POR DENNIS TRUJILLO · BUILT WITH ASTRO</p>
    </div>

  </div>
</footer>

<script>
  function setupFooter() {
    const btn = document.getElementById('footer-back-to-top');
    if (btn && !btn.hasAttribute('data-top-bound')) {
      btn.setAttribute('data-top-bound', 'true');
      btn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  }

  document.addEventListener('astro:page-load', setupFooter);
</script>
